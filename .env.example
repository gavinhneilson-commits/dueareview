# ── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://dueareview.com

# ── Supabase (Project Settings → API) ────────────────
# Leave both blank to run in DEMO MODE with clearly-labelled sample content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NOTE: the service-role key is NOT used anywhere in this app. Never add it here.

# ── Newsletter (optional) ────────────────────────────
# Buttondown API key. When blank, the signup form is shown as "coming soon" and is disabled.
BUTTONDOWN_API_KEY=

# ── Analytics (optional, loaded ONLY after cookie consent) ───
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Link to your analytics dashboard, shown in the admin
NEXT_PUBLIC_ANALYTICS_DASHBOARD_URL=

# ── Search Console verification (optional) ───────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
